<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK スタイルのプロジェクト（.NET Framework 4.8 の WinForms アプリ）。
    フォルダーにある .cs・.resx・App.config は自動でビルドに入るので、ファイルを列挙しなくてよい。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Maze</RootNamespace>
    <AssemblyName>Maze</AssemblyName>
    <!-- バージョンなどは Properties\AssemblyInfo.cs に書いてある -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 出力先は bin\Debug・bin\Release のまま（net48 のフォルダーを挟まない） -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Form1.resx は Form1.cs のクラス名（RogueLike）で埋め込む。これがないとファイル名の
         Maze.Form1.resources になり、Form1.Designer.cs がアイコンなどを読めず起動時に止まる -->
    <EmbeddedResource Update="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
